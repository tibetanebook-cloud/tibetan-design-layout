<?xml version="1.0" encoding="utf-8"?>
<!--
  Tibetan Design Layout MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build designcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.designcraft` owned by
  Tibetan Design Layout, and Tibetan Design Layout offered under "Open with" for IDML (without taking over the user's
  default app for it).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Tibetan Design Layout"
      Manufacturer="StudyTibetan"
      Version="$(var.Version)"
      UpgradeCode="72FA5CDD-C87E-4540-A8E4-AD275D0C4E0A"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Tibetan Design Layout page layout and publishing" Manufacturer="StudyTibetan" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Tibetan Design Layout is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesigncraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesigncraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://nangchen.com" />
    <Property Id="ARPURLUPDATEINFO" Value="https://nangchen.com" />
    <Property Id="ARPHELPLINK" Value="https://studytibetan.com" />

    <!-- Shared native setup UI, including install/uninstall completion. -->

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Tibetan Design Layout" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Tibetan Design Layout" Level="1">
      <ComponentGroupRef Id="DesigncraftFiles" />
      <ComponentGroupRef Id="CraftInstallerSettings" />
    </Feature>
    <!-- Shared full UI; app installation policy remains below. -->
    <UIRef Id="CraftInstallerUI" />
  </Package>

  <Fragment>
    <ComponentGroup Id="DesigncraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DesigncraftApp" Guid="6E1B7513-A538-48F0-810C-5D961330609A">
        <File Id="DesigncraftExe" Source="$(var.BinDir)\Tibetan Design Layout.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Tibetan Design Layout"
              Description="Tibetan Design Layout page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DesigncraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .designcraft: Tibetan Design Layout's own format; Tibetan Design Layout is its default app. -->
        <ProgId Id="Designcraft.Document" Description="Tibetan Design Layout Document" Icon="DesigncraftExe" IconIndex="0">
          <Extension Id="designcraft" ContentType="application/x-designcraft">
            <Verb Id="open" Command="Open" TargetFile="DesigncraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- IDML: offered under "Open with", never forced as the default. -->
        <ProgId Id="Designcraft.Idml" Description="IDML Document" Icon="DesigncraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Designcraft.Idml\shell\open\command" Value="&quot;[#DesigncraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.idml\OpenWithProgids" Name="Designcraft.Idml" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "designcraft"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Tibetan Design Layout.exe" Name="FriendlyAppName" Value="Tibetan Design Layout" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Tibetan Design Layout.exe\shell\open\command" Value="&quot;[#DesigncraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Tibetan Design Layout.exe\SupportedTypes" Name=".designcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Tibetan Design Layout.exe\SupportedTypes" Name=".idml" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\Tibetan Design Layout.exe" Value="[#DesigncraftExe]" Type="string" />
      </Component>

      <Component Id="TibetanNotice0"><File Id="TibetanNoticeFile0" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" /></Component>
      <Component Id="TibetanNotice1"><File Id="TibetanNoticeFile1" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" /></Component>
      <Component Id="TibetanNotice2"><File Id="TibetanNoticeFile2" Source="$(var.BinDir)\NOTICE" KeyPath="yes" /></Component>
      <Component Id="TibetanNotice3"><File Id="TibetanNoticeFile3" Source="$(var.BinDir)\ASSETS.md" KeyPath="yes" /></Component>
      <Component Id="TibetanNotice4"><File Id="TibetanNoticeFile4" Source="$(var.BinDir)\OFL-Tibetan.txt" KeyPath="yes" /></Component>
      <Component Id="DesigncraftCli">
        <File Id="DesigncraftCliExe" Source="$(var.BinDir)\designcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
